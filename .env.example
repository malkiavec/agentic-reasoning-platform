APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://agent:agent@postgres:5432/agentic
REDIS_URL=redis://redis:6379/0
LLM_PROVIDER=mock
LLM_MODEL=reasoning-default
LLM_API_KEY=
LOG_LEVEL=INFO
