APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://agent:agent@postgres:5432/agentic
REDIS_URL=redis://redis:6379/0
LLM_PROVIDER=mock
LLM_MODEL=reasoning-default
LLM_API_KEY=
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# LLM providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LOCAL_MODEL=
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_CONTEXT_TOKENS=128000

# Memory
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MODEL=text-embedding-3-small

# Authentication: set AUTH_MODE=oidc in production
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles
