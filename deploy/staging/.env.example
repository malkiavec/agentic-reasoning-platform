APP_ENV=staging
ENVIRONMENT=staging
AUTH_MODE=oidc
AUTH_REQUIRE_ISSUER_AUDIENCE=true
AUTH_REQUIRE_MEMBERSHIP=true
OIDC_ISSUER=https://idp.example.com/
OIDC_AUDIENCE=agentic-platform
OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
DATABASE_URL=postgresql+asyncpg://agent:CHANGE_ME@postgres:5432/agentic
PSQL_DATABASE_URL=postgresql://agent:CHANGE_ME@postgres:5432/agentic
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=https://staging.example.com
API_RATE_LIMIT_PER_MINUTE=120
OTEL_SERVICE_NAME=agentic-api-staging
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com/v1/traces
# Secret-manager references are injected by the deployment system.
